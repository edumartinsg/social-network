datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  username  String    @unique
  name      String?
  age       Int
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  posts Post[]

  @@map("users")
}

model Post {
  id                    String    @id @default(uuid())
  title                 String
  caption               String?
  mediaType             String
  content               Json
  authorId              String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime?
  deletedAt             DateTime?
  isDeletedByModeration Boolean   @default(false)

  author User @relation(fields: [authorId], references: [id])

  @@map("posts")
}
